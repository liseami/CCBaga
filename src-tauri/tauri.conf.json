{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC清理器",
  "version": "0.2.0",
  "identifier": "ai.local.requirement-french",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && sh scripts/package-browser.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC清理器",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../dist/": "browser-ui/",
      "../browser-runtime/Browser.zip": "browser-runtime/Browser.zip",
      "../browser-runtime/version.txt": "browser-runtime/version.txt",
      "../browser-runtime/LICENSE.fingerprint-chromium": "browser-runtime/LICENSE.fingerprint-chromium"
    }
  }
}
